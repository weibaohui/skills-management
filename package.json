{
  "name": "@weibaohui/skills-management",
  "version": "0.4.1",
  "description": "dsh 插件 · 技能市场：一个页面管理本机所有 coding agent 的技能（Claude、ZCode、Codex 等十余个执行器），一键收编进 DSH 用户库供 skill 工具调用；内置 6600+ ntd 技能市场可浏览搜索安装，支持注入开销（≈token/字符）统计与排序、模型可见性治理与市场每日自动同步。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skills",
    "marketplace",
    "ntd",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@weibaohui/dsh-plugin-kit": "^0.2.0",
    "js-tiktoken": "^1.0.21",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/skills-management.git"
  },
  "homepage": "https://github.com/weibaohui/skills-management#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/skills-management/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
